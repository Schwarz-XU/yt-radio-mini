<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 允许在非 Windows 机器（如 Linux CI）上编译；在 Windows 上无影响。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>YTRadioMini</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>YT Radio Mini</Product>
    <Authors>Schwarz-XU</Authors>
    <Copyright>Copyright (C) 2026 Schwarz-XU. Licensed under the LGPL-3.0-or-later.</Copyright>
    <Description>A minimal retro audio player for YouTube links.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口/任务栏图标：除了 exe 自带的图标，也把它嵌入程序集，供 Form.Icon 读取 -->
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
