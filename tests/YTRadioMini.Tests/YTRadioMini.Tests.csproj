<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>YTRadioMini.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    主项目目标为 net10.0-windows，无法被 net10.0 测试项目直接引用。
    这里把不依赖 WinForms 的源码目录直接链接进来，使测试可在任何平台运行。
    UI/ 与 Program.cs 不在其中，因此这些目录下的文件不得引用 System.Windows.Forms / System.Drawing。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\YTRadioMini\Models\**\*.cs" Link="Linked\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\YTRadioMini\Services\**\*.cs" Link="Linked\Services\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\YTRadioMini\Application\**\*.cs" Link="Linked\Application\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\YTRadioMini\Mocks\**\*.cs" Link="Linked\Mocks\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
